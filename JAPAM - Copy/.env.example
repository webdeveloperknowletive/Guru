# ==============================================================================
# SPIRITUAL COMMERCE ADMIN - ENVIRONMENT CONFIGURATION
# Production Deployment for Hostinger VPS with Coolify
# ==============================================================================

# Core Application Settings
FLASK_ENV=production
FLASK_APP=wsgi.py
SECRET_KEY=change-this-to-a-super-secret-random-hex-in-production
APP_NAME="Spiritual Commerce Admin"
APP_SUBTITLE="Seva · Sanskriti · Samṛddhi"
TIMEZONE=Asia/Kolkata
PORT=5000

# Security and Cookies
# Set to 'true' in production with HTTPS (Coolify manages SSL automatically via Traefik/Let's Encrypt)
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=japam_admin_session
JWT_SECRET_KEY=change-this-jwt-secret-in-production-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=14
CSRF_SECRET_KEY=change-this-csrf-secret-key-32-chars-minimum

# Payment Gateway (Razorpay) & Webhook Secrets
# Required for production payments. Must match Razorpay dashboard settings.
PAYMENT_WEBHOOK_SECRET=whsec_your_razorpay_webhook_secret_here
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# External Frontend Origins & CORS
# Comma-separated list of allowed origins (e.g. https://store.yourdomain.com,http://localhost:3000)
FRONTEND_ORIGINS=https://store.yourdomain.com,http://localhost:3000,http://localhost:5173

# Database (PostgreSQL 16)
# Format for PostgreSQL: postgresql+psycopg://username:password@host:5432/database_name
# For local dev without Postgres, fallback to: sqlite:///japam_admin.db
DATABASE_URL=postgresql+psycopg://japam_user:secure_japam_password@postgres:5432/japam_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis Cache, Distributed Rate Limiting & Queue
# Format: redis://[:password]@host:6379/db_number
REDIS_URL=redis://redis:6379/0
REDIS_RATE_LIMIT_PREFIX=rl:
REDIS_TOKEN_BLACKLIST_PREFIX=bl:

# Google OAuth 2.0 / OpenID Connect (Optional)
# If empty, admin password authentication remains fully functional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_REDIRECT_URI=https://admin.yourdomain.com/auth/oauth/google/callback

# Storage and Uploads
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=10485760 # 10MB max upload size
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,svg

# Rate Limiting Thresholds (sliding window per minute)
LOGIN_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=3
API_RATE_LIMIT_PER_MINUTE=120

# Notifications & Asynchronous Worker
WORKER_CONCURRENCY=2
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=admin@yourdomain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME="Spiritual Commerce Seva"
