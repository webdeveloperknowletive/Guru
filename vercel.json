

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "astroveda/",
      "framework": "nextjs"
    },
    "api": {
      "root": "japam-backend/",
      "framework": "flask",
      "entrypoint": "wsgi:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}

  "daemons": {
    "worker": {
      "root": "japam-backend/",
      "entrypoint": "Dockerfile",
      "command": ["python", "worker.py"],
      "instances": {
        "bom1": 1
      }
    }
  }
}
